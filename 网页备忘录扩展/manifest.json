{
  "manifest_version": 3,
  "name": "网页备忘录",
  "version": "1.5.0",
  "description": "网页备忘录：关联本地附件、拖出真实文件、快速改名和 ZIP 自动解压。",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "打开本页备忘录"
  },
  "options_page": "options.html"
}
